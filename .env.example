# Jago Platform Environment Variable Configuration
# For production Supabase deployment, fill in your project URL and Anon key.
# Note: Service Role keys must NEVER use VITE_ prefix or be exposed to client bundles.

VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
